# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Твой Telegram id (узнать: @userinfobot). Несколько — через запятую.
# Если пусто — ботом сможет пользоваться кто угодно.
ALLOWED_USERS=

# Как часто опрашивать Variational, секунд (лимит API: 10 запросов / 10 сек)
POLL_SECONDS=30

# Игнорировать котировки старше N секунд (API кэширует их до 600 с)
MAX_QUOTE_AGE_SECONDS=900
